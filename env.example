# FinAgent — API Keys Configuration
# Copy this file to .env and fill in your real keys
# NEVER commit the .env file to GitHub

# Required: Groq API (free at console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: NewsAPI (free at newsapi.org)
NEWSAPI_KEY=your_newsapi_key_here

# Optional: Alpha Vantage (free at alphavantage.co/support/#api-key)
# Free tier: 25 requests/day, 5 requests/min
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# Optional: FRED (free at fred.stlouisfed.org)
FRED_API_KEY=your_fred_key_here
